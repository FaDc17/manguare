# App Service manguare-services (Linux, runtime Node.js 22+).
# Valores para Configuration > Application settings. No subir secretos reales.
SCM_DO_BUILD_DURING_DEPLOYMENT=true
NODE_ENV=production
MANGUARE_STORAGE=azure-sql
AZURE_SQL_SERVER=sql-kuska-fadc.database.windows.net
AZURE_SQL_DATABASE=manguara_bd
AZURE_SQL_PORT=1433
AZURE_SQL_AUTHENTICATIONTYPE=azure-active-directory-default
MANGUARE_PANEL_USER=salud
MANGUARE_PANEL_PASSWORD=REEMPLAZAR_CON_LA_CONTRASENA_ACTUAL_DEL_PANEL
MANGUARE_SESSION_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
MANGUARE_SECURE_COOKIES=1
MANGUARE_TRUST_PROXY=1
