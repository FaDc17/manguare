# Copia este archivo a .env y cambia la contraseña antes de usar Docker.
MANGUARE_PANEL_PASSWORD=cambia-esta-clave
MANGUARE_PANEL_USER=salud

# Genera uno con: openssl rand -base64 48
MANGUARE_SESSION_SECRET=cambia-este-secreto-largo-y-aleatorio
MANGUARE_SESSION_HOURS=12

# Plazo para que la red confirme una alerta y teléfono de respaldo para escalar.
MANGUARE_ACK_MINUTES=10
MANGUARE_ESCALATION_PHONE=+51999999999
MANGUARE_BIODIVERSITY_FILE=/data/biodiversity.json

# Ponlos en 1 solo si publicas el panel por HTTPS detrás de un proxy inverso.
MANGUARE_SECURE_COOKIES=0
MANGUARE_TRUST_PROXY=0

GEMINI_API_KEY=your_gemini_api_key_here

# Compila el APK con la URL HTTPS de la API cuando esté publicada.
# VITE_API_BASE_URL=https://manguare-services-c9hpebgcduf0gfdr.eastus2-01.azurewebsites.net
# Activa Azure SQL solo después de ejecutar database/03_azure_app_state.sql
# y database/04_azure_identity.sql y comprobar el acceso.
# MANGUARE_STORAGE=azure-sql
# AZURE_SQL_SERVER=sql-kuska-fadc.database.windows.net
# AZURE_SQL_DATABASE=manguara_bd
# AZURE_SQL_PORT=1433
# AZURE_SQL_AUTHENTICATIONTYPE=azure-active-directory-default
